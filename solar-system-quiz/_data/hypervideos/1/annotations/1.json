        "body": {
            "type": "Text",
            "frametrail:type": "wikipedia",
            "format": "text/html",
            "value": "https://en.wikipedia.org/wiki/Solar_System",
            "frametrail:name": "Solar System",
            "frametrail:thumb": "https://upload.wikimedia.org/wikipedia/commons/thumb/a/ac/Solar_System_true_color_%28title_and_caption%29.jpg/330px-Solar_System_true_color_%28title_and_caption%29.jpg",
            "frametrail:licenseType": null,
            "frametrail:licenseAttribution": null,
            "frametrail:resourceId": "2",
            "frametrail:attributes": {
                "extract": "The Solar System is the gravitationally bound system of the Sun and the masses that orbit it, most prominently its eight planets, of which Earth is one. The system formed about 4.6 billion years ago when a dense region of a molecular cloud collapsed, creating the Sun and a protoplanetary disc from which the orbiting bodies assembled.",
                "extract_html": "<p>The <b>Solar System</b> is the gravitationally bound system of the Sun and the masses that orbit it, most prominently its eight planets, of which Earth is one. The system formed about 4.6 billion years ago when a dense region of a molecular cloud collapsed, creating the Sun and a protoplanetary disc from which the orbiting bodies assembled.</p>",
                "description": "Planetary system consisting of the Sun and objects orbiting it",
                "articleUrl": "https://en.wikipedia.org/wiki/Solar_System",
                "wikiLang": "en",
                "dir": "ltr"
            }
        }
