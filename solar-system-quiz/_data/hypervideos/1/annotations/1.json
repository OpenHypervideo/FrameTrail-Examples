            "value": "https://en.wikipedia.org/wiki/Venus",
            "frametrail:name": "Venus",
            "frametrail:thumb": "https://upload.wikimedia.org/wikipedia/commons/thumb/b/b2/Venus_2_Approach_Image.jpg/330px-Venus_2_Approach_Image.jpg",
            "frametrail:licenseType": null,
            "frametrail:licenseAttribution": null,
            "frametrail:resourceId": "4",
            "frametrail:attributes": {
                "extract": "Venus is the second planet from the Sun. It is often called Earth's \"twin\" or \"sister\" among the planets of the Solar System for its orbit being the closest to Earth's, both being terrestrial planets, and having the most similar and nearly equal size, mass, and surface gravity.",
                "extract_html": "<p><b>Venus</b> is the second planet from the Sun. It is often called Earth's \"twin\" or \"sister\" among the planets of the Solar System for its orbit being the closest to Earth's, both being terrestrial planets, and having the most similar and nearly equal size, mass, and surface gravity.</p>",
                "description": "Second planet from the Sun",
                "articleUrl": "https://en.wikipedia.org/wiki/Venus",
                "wikiLang": "en",
                "dir": "ltr"
            }
        }
