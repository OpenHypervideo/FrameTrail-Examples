                    "onClickContentItem": "",
                    "html": "<style>\n  .quiz-progress {\n    padding: 16px;\n    font-family: 'Space Grotesk', sans-serif;\n    box-sizing: border-box;\n    height: 100%;\n  }\n  .quiz-progress h3 {\n    margin: 0 0 16px 0;\n    font-size: 1.1em;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n  .quiz-progress__item {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 8px 0;\n    border-bottom: 1px solid rgba(255,255,255,0.08);\n  }\n  .quiz-progress__dot {\n    width: 12px;\n    height: 12px;\n    border-radius: 50%;\n    background: rgba(255,255,255,0.15);\n    flex-shrink: 0;\n    transition: background 0.4s, box-shadow 0.4s;\n  }\n  .quiz-progress__dot.correct {\n    background: #4caf50;\n    box-shadow: 0 0 8px rgba(76,175,80,0.6);\n  }\n  .quiz-progress__dot.wrong {\n    background: #ff9800;\n    box-shadow: 0 0 8px rgba(255,152,0,0.6);\n  }\n  .quiz-progress__score {\n    margin-top: 20px;\n    padding: 12px;\n    border-radius: 8px;\n    background: rgba(255,255,255,0.05);\n    text-align: center;\n    font-size: 1.2em;\n  }\n</style>\n<div class=\"quiz-progress\">\n  <h3>Quiz Progress</h3>\n  <div id=\"quizProgressList\"></div>\n  <div class=\"quiz-progress__score\" id=\"quizScore\">Score: 0 / 0</div>\n</div>",
