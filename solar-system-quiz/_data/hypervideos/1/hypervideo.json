    "globalEvents": {
        "onReady": "window.quizData = [\n  { id: 1, label: 'Closest planet to the Sun', question: 'Which planet is closest to the Sun?' },\n  { id: 2, label: 'Planet order from the Sun', question: 'What is the correct order of the first four planets from the Sun?' },\n  { id: 3, label: 'Largest planet', question: 'Which is the largest planet in our Solar System?' },\n  { id: 4, label: 'The Red Planet', question: 'Which planet is known as the \\'Red Planet\\'?' },\n  { id: 5, label: 'Gas giants vs rocky planets', question: 'Which of the following are classified as gas giants?' },\n  { id: 6, label: 'Multi-answer: Inner planets', question: 'Which of the following are rocky inner planets? (Select the best answer)' },\n  { id: 7, label: 'Distance unit in space', question: 'What unit is used to measure distances within the Solar System?' }\n];\nwindow.quizResults = {};\nwindow.quizTotal = 0;\nwindow.quizCorrect = 0;\n\nvar list = document.getElementById('quizProgressList');\nif (list) {\n  quizData.forEach(function(q) {\n    var item = document.createElement('div');\n    item.className = 'quiz-progress__item';\n    item.innerHTML = '<div class=\"quiz-progress__dot\" id=\"quizDot' + q.id + '\"></div><span>' + q.label + '</span>';\n    list.appendChild(item);\n  });\n}\n\nwindow.updateQuizProgress = function(quizId, correct) {\n  if (window.quizResults[quizId]) return;\n  window.quizResults[quizId] = correct ? 'correct' : 'wrong';\n  window.quizTotal++;\n  if (correct) window.quizCorrect++;\n  var dot = document.getElementById('quizDot' + quizId);\n  if (dot) dot.className = 'quiz-progress__dot ' + (correct ? 'correct' : 'wrong');\n  var score = document.getElementById('quizScore');\n  if (score) score.textContent = 'Score: ' + window.quizCorrect + ' / ' + window.quizTotal;\n};\n\n// The quizAnswered event names the question; it marks the matching entry.\nif (window.quizAnsweredHandler) {\n  FrameTrail.removeEventListener('quizAnswered', window.quizAnsweredHandler);\n}\nwindow.quizAnsweredHandler = function(evt) {\n  var q = window.quizData.filter(function(q) { return q.question === evt.detail.question; })[0];\n  if (q) window.updateQuizProgress(q.id, evt.detail.correct);\n};\nFrameTrail.addEventListener('quizAnswered', window.quizAnsweredHandler);",
        "onPlay": "",
        "onPause": "",
        "onEnded": ""
    },
