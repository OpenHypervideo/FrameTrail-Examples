    "globalEvents": {
        "onReady": "// Learning path: colour the dot of a question when it is answered. The first try counts for the score.\nif (window.solarQuizHandler) {\n    FrameTrail.removeEventListener('quizAnswered', window.solarQuizHandler);\n}\nvar results = {};\nfunction paint() {\n    var dots = document.querySelectorAll('.learningPath .lpDot[data-question]'), right = 0, i, result;\n    for (i = 0; i < dots.length; i++) {\n        result = results[dots[i].getAttribute('data-question')];\n        if (result && result.first) { right++; }\n        dots[i].className = 'lpDot' + (!result ? '' : result.first ? ' right' : result.solved ? ' retried' : ' wrong');\n    }\n    var score = document.querySelector('.learningPath .lpScoreValue');\n    if (score) { score.textContent = right + ' of ' + dots.length; }\n}\nwindow.solarQuizHandler = function (evt) {\n    var question = evt.detail.question, correct = evt.detail.correct === true;\n    if (!results[question]) { results[question] = { first: correct, solved: correct }; }\n    if (correct) { results[question].solved = true; }\n    paint();\n};\nFrameTrail.addEventListener('quizAnswered', window.solarQuizHandler);\npaint();",
        "onPlay": "",
        "onPause": "",
        "onEnded": ""
    },
