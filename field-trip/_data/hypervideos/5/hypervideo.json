                "value": "",
                "frametrail:name": "Horst Bert Molkenbuhr spent five years i…",
                "frametrail:thumb": null,
                "frametrail:licenseType": null,
                "frametrail:licenseAttribution": null,
                "frametrail:attributes": {
                    "text": "&lt;p style=\"text-align: center;\"&gt;Horst Bert Molkenbuhr spent five years in a Nazi re-education camp as a child because his family was close to the left-wing Social Democratic Party. &lt;br&gt;&lt;br&gt;He tells us a story that is rarely mentioned in the usual reports about the airlift.&lt;br&gt;&lt;br&gt;In 1949, thousands of teenagers spent their summer holidays &lt;br&gt;on Tempelhof Field assisting the Allies.&lt;br&gt;&lt;br&gt;He was one of them.&lt;/p&gt;",
                    "box": {
