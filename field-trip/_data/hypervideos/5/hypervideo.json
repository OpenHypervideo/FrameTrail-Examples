                "format": "text/html",
                "value": "",
                "frametrail:name": "The Western Allies’ response was to brin…",
                "frametrail:thumb": null,
                "frametrail:licenseType": null,
                "frametrail:licenseAttribution": null,
                "frametrail:attributes": {
                    "text": "&lt;p style=\"text-align: center;\"&gt;The Western Allies’ response &lt;br&gt;was to bring supplies to the city by air.&lt;br&gt;&lt;br&gt;The Berlin Airlift lasted from 24th June 1948 &lt;br&gt;until 12th May 1949.&lt;/p&gt;",
