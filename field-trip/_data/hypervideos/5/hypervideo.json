                "type": "TextualBody",
                "frametrail:type": "text",
                "format": "text/html",
                "value": "",
                "frametrail:name": "In 1948, Berlin was divided up between t…",
                "frametrail:thumb": null,
                "frametrail:licenseType": null,
                "frametrail:licenseAttribution": null,
                "frametrail:attributes": {
                    "text": "&lt;p style=\"text-align: center;\"&gt;In 1948, Berlin was divided up between the four victorious powers.&lt;br&gt;West Berlin, administered by France, the UK and the US, was an enclave within the Soviet occupation zone. &lt;br&gt;&lt;br&gt;In the summer of 1948, the Soviets blocked all land and water routes to West Berlin.&lt;/p&gt;",
                    "box": {
                        "shape": "rectangle",
                        "background": "rgba(0,0,0,0.45)",
                        "textColor": "#ffffff",
                        "padding": 19
                    },
                    "autoSize": "height",
