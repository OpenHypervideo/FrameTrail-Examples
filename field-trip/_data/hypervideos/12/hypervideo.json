                "frametrail:licenseAttribution": null,
                "frametrail:attributes": {
                    "text": "&lt;p style=\"text-align: center;\"&gt;At the start, it was mainly Syrian men who lived in the prefabs. They had fled the war or the risk of conscription into the army. With the rising number of asylum seekers in Germany, getting permission for their families to join them became increasingly difficult.&lt;/p&gt;",
                    "box": {
                        "shape": "rectangle",
