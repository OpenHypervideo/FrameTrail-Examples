            "body": {
                "type": "TextualBody",
                "frametrail:type": "text",
                "format": "text/html",
                "value": "",
                "frametrail:name": "What this is",
                "frametrail:attributes": {
                    "text": "&lt;p&gt;&lt;span style=&quot;font-size: 21px;&quot;&gt;&lt;strong&gt;One painting, three pictures&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;A photograph, an infrared reflectogram and an X-ray of the same panel. Move the pointer or a finger over the picture to look beneath the paint, and choose the layer below.&lt;/span&gt;&lt;/p&gt;",
                    "autoSize": "height",
                    "box": {
                        "background": "rgba(12, 14, 18, 0.86)",
                        "textColor": "#ffffff",
                        "padding": 20,
                        "radius": 6
                    },
                    "zIndex": 6,
                    "animation": {
                        "in": {
                            "preset": "fadeIn",
                            "duration": 400
                        },
                        "out": {
                            "preset": "fadeOut",
                            "duration": 300
                        }
                    }
                }
            },
            "frametrail:events": {
                "onStart": "if (window.frametrailLens) { frametrailLens.show('infrared', 50, 50); }"
            }
        },
