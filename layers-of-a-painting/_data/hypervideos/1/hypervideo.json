                "format": "text/html",
                "value": "",
                "frametrail:name": "What stops an X-ray",
                "frametrail:attributes": {
                    "text": "&lt;p&gt;&lt;span style=&quot;font-size: 13px; color: #f2c66d;&quot;&gt;&lt;strong&gt;X-RAY&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 26px;&quot;&gt;&lt;strong&gt;What stops an X-ray&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;X-rays are stopped by dense pigments, above all lead white. The turban and the rows of pearls shine; thin dark paint leaves no trace.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 13px; color: #b9c0c9;&quot;&gt;Move the lens, then press play to go on.&lt;/span&gt;&lt;/p&gt;",
                    "autoSize": "height",
                    "box": {
                        "background": "rgba(12, 14, 18, 0.86)",
                        "textColor": "#ffffff",
                        "padding": 20,
                        "radius": 6
                    },
                    "zIndex": 6,
                    "animation": {
                        "in": {
                            "preset": "fadeIn",
                            "duration": 400
                        },
                        "out": {
                            "preset": "fadeOut",
                            "duration": 300
                        }
                    }
                }
            },
            "frametrail:events": {
                "onStart": "if (window.frametrailLens) { frametrailLens.show('xray', 67.7, 32.1); }"
            },
            "frametrail:pause": true
        },
