            "body": {
                "type": "TextualBody",
                "frametrail:type": "text",
                "format": "text/html",
                "value": "",
                "frametrail:name": "Under the blue robe",
                "frametrail:attributes": {
                    "text": "&lt;p&gt;&lt;span style=&quot;font-size: 13px; color: #f2c66d;&quot;&gt;&lt;strong&gt;INFRARED&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 26px;&quot;&gt;&lt;strong&gt;Under the blue robe&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;Infrared light passes through many paints and is stopped by carbon black, so it shows what was drawn before the painting began. Under the Virgin&amp;#x27;s robe the folds appear as lines and hatching.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 13px; color: #b9c0c9;&quot;&gt;Move the lens, then press play to go on.&lt;/span&gt;&lt;/p&gt;",
                    "autoSize": "height",
                    "box": {
                        "background": "rgba(12, 14, 18, 0.86)",
                        "textColor": "#ffffff",
                        "padding": 20,
                        "radius": 6
                    },
                    "zIndex": 6,
                    "animation": {
                        "in": {
                            "preset": "fadeIn",
                            "duration": 400
                        },
                        "out": {
                            "preset": "fadeOut",
                            "duration": 300
                        }
                    }
                }
            },
            "frametrail:events": {
                "onStart": "if (window.frametrailLens) { frametrailLens.show('infrared', 47.6, 69.7); }"
            },
            "frametrail:pause": true
        },
