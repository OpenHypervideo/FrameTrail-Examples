                "frametrail:name": "The grid is not in the painting",
                "frametrail:attributes": {
                    "text": "&lt;p&gt;&lt;span style=&quot;font-size: 13px; color: #f2c66d;&quot;&gt;&lt;strong&gt;X-RAY&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 26px;&quot;&gt;&lt;strong&gt;The grid is not in the painting&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;An X-ray sees through everything at once, also the back. The grid is a cradle: wooden bars fixed to the back of the oak panel to keep it flat.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 13px; color: #b9c0c9;&quot;&gt;Move the lens, then press play to go on.&lt;/span&gt;&lt;/p&gt;",
