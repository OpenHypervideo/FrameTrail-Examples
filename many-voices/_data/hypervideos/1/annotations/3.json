            "frametrail:name": "“Pillar-biter” was an insult for someone who made a show of ",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;voiceNote&quot; data-voice=&quot;3&quot;&gt;&lt;p class=&quot;voiceName&quot;&gt;Folklorist&lt;/p&gt;&lt;p&gt;“Pillar-biter” was an insult for someone who made a show of piety. The Dutch word, pilaarbijter, still exists.&lt;/p&gt;&lt;/div&gt;"
            }
        }
