            "format": "text/html",
            "value": "",
            "frametrail:name": "A print by Frans Hogenberg from about 1558 shows many of the",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;voiceNote&quot; data-voice=&quot;2&quot;&gt;&lt;p class=&quot;voiceName&quot;&gt;Art historian&lt;/p&gt;&lt;p&gt;A print by Frans Hogenberg from about 1558 shows many of the same proverbs. Bruegel very probably knew it.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
