            "format": "text/html",
            "value": "",
            "frametrail:name": "The upside-down globe is the key to the whole picture. An ol",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;voiceNote&quot; data-voice=&quot;2&quot;&gt;&lt;p class=&quot;voiceName&quot;&gt;Art historian&lt;/p&gt;&lt;p&gt;The upside-down globe is the key to the whole picture. An old name for the painting is “The Topsy-Turvy World”.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
