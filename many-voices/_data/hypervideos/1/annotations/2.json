            "format": "text/html",
            "value": "",
            "frametrail:name": "The woman in red and the man in blue stand almost in the mid",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;voiceNote&quot; data-voice=&quot;2&quot;&gt;&lt;p class=&quot;voiceName&quot;&gt;Art historian&lt;/p&gt;&lt;p&gt;The woman in red and the man in blue stand almost in the middle. For a long time the painting was simply called “The Blue Cloak”.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
