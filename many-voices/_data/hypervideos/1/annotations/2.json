            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "The horizon lies very high. That is what gives Bruegel room ",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;voiceNote&quot; data-voice=&quot;2&quot;&gt;&lt;p class=&quot;voiceName&quot;&gt;Art historian&lt;/p&gt;&lt;p&gt;The horizon lies very high. That is what gives Bruegel room for more than a hundred scenes on one panel.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
