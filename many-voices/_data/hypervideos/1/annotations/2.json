        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "The busiest scenes are in the foreground, and the eye is lef",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;voiceNote&quot; data-voice=&quot;2&quot;&gt;&lt;p class=&quot;voiceName&quot;&gt;Art historian&lt;/p&gt;&lt;p&gt;The busiest scenes are in the foreground, and the eye is left to wander upwards. There is no single centre.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
