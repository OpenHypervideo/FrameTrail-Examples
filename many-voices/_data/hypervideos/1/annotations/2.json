            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "The figures are types, not portraits: round faces, plain clo",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;voiceNote&quot; data-voice=&quot;2&quot;&gt;&lt;p class=&quot;voiceName&quot;&gt;Art historian&lt;/p&gt;&lt;p&gt;The figures are types, not portraits: round faces, plain clothes, each absorbed in one action.&lt;/p&gt;&lt;/div&gt;"
            }
        }
