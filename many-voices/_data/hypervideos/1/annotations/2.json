            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "The colours are few: earth browns, with red and blue as sign",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;voiceNote&quot; data-voice=&quot;2&quot;&gt;&lt;p class=&quot;voiceName&quot;&gt;Art historian&lt;/p&gt;&lt;p&gt;The colours are few: earth browns, with red and blue as signals that pull the eye from scene to scene.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
