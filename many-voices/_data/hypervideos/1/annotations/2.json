            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "We see the roofs from above and the people from the side. Th",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;voiceNote&quot; data-voice=&quot;2&quot;&gt;&lt;p class=&quot;voiceName&quot;&gt;Art historian&lt;/p&gt;&lt;p&gt;We see the roofs from above and the people from the side. The viewpoint is impossible, and it means nothing hides anything.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
