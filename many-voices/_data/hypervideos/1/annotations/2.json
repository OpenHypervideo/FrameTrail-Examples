            "format": "text/html",
            "value": "",
            "frametrail:name": "Painted in 1559 on an oak panel about 1.6 metres wide. Today",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;voiceNote&quot; data-voice=&quot;2&quot;&gt;&lt;p class=&quot;voiceName&quot;&gt;Art historian&lt;/p&gt;&lt;p&gt;Painted in 1559 on an oak panel about 1.6 metres wide. Today it hangs in the Gemäldegalerie in Berlin.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
