            "value": "",
            "frametrail:name": "Tracing the smoke back",
            "frametrail:attributes": {
                "title": "Tracing the smoke back",
                "text": "&lt;p&gt;With the camera placed in the model, the plume can be traced to its source: the north-east corner of Warehouse 12.&lt;/p&gt;"
            }
        }
    },
