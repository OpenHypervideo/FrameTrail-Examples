            "frametrail:name": "Reading the smoke",
            "frametrail:attributes": {
                "title": "Reading the smoke",
                "text": "&lt;p&gt;Within two minutes the smoke thickens and darkens. According to the explosives analyst the team consulted, that suggests a different material has started to burn.&lt;/p&gt;"
            }
        }
    },
