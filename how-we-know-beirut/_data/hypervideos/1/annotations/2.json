        },
        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Counting the bags",
            "frametrail:attributes": {
                "title": "Counting the bags",
                "text": "&lt;p&gt;The images and videos allowed 243 bags to be mapped. The other 2,507 must have been near bay 8, where the spherical plume began: almost 2,000 square metres, and probably more, given how untidily the visible bags lie.&lt;/p&gt;"
            }
        }
    },
