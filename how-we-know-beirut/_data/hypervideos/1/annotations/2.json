        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Placing what cannot be seen",
            "frametrail:attributes": {
                "title": "Placing what cannot be seen",
                "text": "&lt;p&gt;Burning tyres give a dark, thick plume, so the tyres are placed where the dark plume rose, in the north-east. The white plume in the north-west matches fireworks igniting, so the fireworks are placed there.&lt;/p&gt;"
            }
        }
    },
