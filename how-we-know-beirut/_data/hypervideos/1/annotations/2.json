            "frametrail:name": "Synchronisation",
            "frametrail:attributes": {
                "title": "Synchronisation",
                "text": "&lt;p&gt;Smoke plumes change all the time and have a unique shape at every moment. The plume is modelled at this stage, so that videos without a time stamp can be put in order by its shape.&lt;/p&gt;"
            }
        }
    },
