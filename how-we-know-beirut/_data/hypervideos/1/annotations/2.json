            "frametrail:name": "A close look",
            "frametrail:attributes": {
                "title": "A close look",
                "text": "&lt;p&gt;Early footage shows smoke leaking from every opening, windows and ceiling vents included. From about 5:56 pm the temperature inside rises fast.&lt;/p&gt;"
            }
        }
    },
