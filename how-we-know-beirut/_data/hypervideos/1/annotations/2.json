        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "The Australian equation",
            "frametrail:attributes": {
                "title": "The Australian equation",
                "text": "&lt;p&gt;Stacks of 500 tonnes, 890 metres from the nearest homes. By the same equation a single stack of 2,750 tonnes would need 1,570 metres.&lt;/p&gt;"
            }
        }
    }
