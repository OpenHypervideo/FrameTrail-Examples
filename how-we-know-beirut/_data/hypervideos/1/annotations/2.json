        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Comparison with British rules",
            "frametrail:attributes": {
                "title": "Comparison with British rules",
                "text": "&lt;p&gt;Stacks of ammonium nitrate limited to 300 tonnes, each at least one metre from walls and from other stacks.&lt;/p&gt;"
            }
        }
    },
