            "format": "text/html",
            "value": "",
            "frametrail:name": "Open sources",
            "frametrail:attributes": {
                "title": "Open sources",
                "text": "&lt;p&gt;Videos, photographs and documents that were already public are the raw material: enough to build a timeline and a precise 3D model.&lt;/p&gt;"
            }
        }
    },
