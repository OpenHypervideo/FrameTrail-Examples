            "value": "",
            "frametrail:name": "Reading the ceiling",
            "frametrail:attributes": {
                "title": "Reading the ceiling",
                "text": "&lt;p&gt;The bay numbers visible on the ceiling place the photographed bags in bays 9 and 10, beside a container and a stack of wooden pallets.&lt;/p&gt;"
            }
        }
    },
    {
        "@context": [
