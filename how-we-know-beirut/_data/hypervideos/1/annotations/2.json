            "format": "text/html",
            "value": "",
            "frametrail:name": "Stabilised footage",
            "frametrail:attributes": {
                "title": "Stabilised footage",
                "text": "&lt;p&gt;Footage from the east side is stabilised to show the whole length of the warehouse. Many windows and doors are shut; the sound of fireworks begins at about 5:59 pm.&lt;/p&gt;"
            }
        }
    },
