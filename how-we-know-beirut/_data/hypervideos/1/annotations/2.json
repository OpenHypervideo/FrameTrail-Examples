            "frametrail:name": "A second camera",
            "frametrail:attributes": {
                "title": "A second camera",
                "text": "&lt;p&gt;A video from a balcony of the residential tower, shot at about the same time, shows the same source of fire on the same side of the warehouse.&lt;/p&gt;"
            }
        }
    },
