            "value": "",
            "frametrail:name": "Geolocation",
            "frametrail:attributes": {
                "title": "Geolocation",
                "text": "&lt;p&gt;The first photograph of the fire, posted on Twitter at 5:54 pm, is located by identifying the key buildings in it. That gives the camera&amp;#x27;s position and its cone of vision.&lt;/p&gt;"
            }
        }
    },
