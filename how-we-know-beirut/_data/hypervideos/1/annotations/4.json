            "frametrail:name": "6:08 pm: the explosion",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;4&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Findings&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;6:08 pm: the explosion&lt;/p&gt;&lt;p&gt;Thirty-five seconds later a large spherical plume appears above the centre of the warehouse. Its symmetry suggests a single-point explosion; possibly as little as half of the 2,750 sacks detonated.&lt;/p&gt;&lt;/div&gt;"
            }
        }
