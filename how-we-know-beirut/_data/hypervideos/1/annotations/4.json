            "format": "text/html",
            "value": "",
            "frametrail:name": "State negligence",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;4&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Findings&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;State negligence&lt;/p&gt;&lt;p&gt;All these rules forbid storing combustible or explosive goods such as tyres or fireworks near ammonium nitrate. The film calls it “substantial and sustained state negligence”.&lt;/p&gt;&lt;p class=&quot;dossierLink&quot;&gt;&lt;a href=&quot;https://forensic-architecture.org/investigation/beirut-port-explosion&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Read the investigation ↗&lt;/a&gt;&lt;/p&gt;&lt;/div&gt;"
