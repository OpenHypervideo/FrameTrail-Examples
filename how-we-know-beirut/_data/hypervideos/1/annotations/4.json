            "frametrail:name": "Four plumes in fourteen minutes",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;4&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Findings&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;Four plumes in fourteen minutes&lt;/p&gt;&lt;p&gt;5:54 pm, north-east corner. 6:00 pm, the same source, darker. 6:07 pm, north-west side. 6:08 pm, the spherical explosion at the centre. Their shapes and colours point to how the goods were arranged.&lt;/p&gt;&lt;/div&gt;"
            }
        }
