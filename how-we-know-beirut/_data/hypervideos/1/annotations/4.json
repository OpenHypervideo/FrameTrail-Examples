            "frametrail:name": "Shut in",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;4&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Findings&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;Shut in&lt;/p&gt;&lt;p&gt;According to the expert, confinement creates hot spots in which ammonium nitrate can get close to its combustion point.&lt;/p&gt;&lt;/div&gt;"
            }
