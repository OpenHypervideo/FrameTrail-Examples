            "value": "",
            "frametrail:name": "Arranged like a bomb",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;4&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Findings&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;Arranged like a bomb&lt;/p&gt;&lt;p&gt;“From an engineering perspective this is the spatial layout of a makeshift bomb on the scale of a warehouse, awaiting detonation.”&lt;/p&gt;&lt;/div&gt;"
            }
        }
