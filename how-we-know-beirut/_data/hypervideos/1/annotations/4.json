            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;4&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Findings&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;755 metres in nine seconds&lt;/p&gt;&lt;p&gt;The spherical plume shoots up, and a red plume 755 metres high stands over the warehouse.&lt;/p&gt;&lt;/div&gt;"
