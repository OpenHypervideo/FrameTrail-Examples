            "frametrail:name": "The fire brigade",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;The fire brigade&lt;/p&gt;&lt;p&gt;As reported by media outlets, the brigade arrived about four minutes after the call to the station at 5:54 pm. Its own footage records the sound of fireworks.&lt;/p&gt;&lt;/div&gt;"
            }
