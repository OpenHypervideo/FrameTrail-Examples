            "format": "text/html",
            "value": "",
            "frametrail:name": "The expert's words",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;The expert&amp;#x27;s words&lt;/p&gt;&lt;p&gt;“Ammonium nitrate is extremely difficult to detonate by fire alone. However, when confined and contaminated, this … can lead to catastrophic detonation.”&lt;/p&gt;&lt;/div&gt;"
            }
        }
