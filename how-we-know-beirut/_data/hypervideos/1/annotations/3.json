            "frametrail:name": "Leaked images, 2020",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;Leaked images, 2020&lt;/p&gt;&lt;p&gt;They show the sacks still torn and spilling. The film shows them in an article of the New York Times.&lt;/p&gt;&lt;/div&gt;"
            }
        }
