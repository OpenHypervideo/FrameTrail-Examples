            "value": "",
            "frametrail:name": "The survivors",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;The survivors&lt;/p&gt;&lt;p&gt;About a thousand survivors and victims&amp;#x27; families have called for an independent investigation and public access to all relevant documents. The statements shown are from the report by Legal Action Worldwide.&lt;/p&gt;&lt;/div&gt;"
            }
