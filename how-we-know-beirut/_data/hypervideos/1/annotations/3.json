            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "What news reports listed",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;What news reports listed&lt;/p&gt;&lt;p&gt;Besides the ammonium nitrate: 23 tonnes of fireworks, 50 tonnes of ammonium phosphate, 5 tonnes of tea and coffee, 5 rolls of slow-burning detonating cord and 1,000 car tyres. The list on screen is from MTV Lebanon.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
