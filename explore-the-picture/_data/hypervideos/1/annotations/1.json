            "frametrail:licenseAttribution": "Pieter Bruegel the Elder, Netherlandish Proverbs (1559). Gemäldegalerie, Berlin. Scan: Google Art Project, via Wikimedia Commons",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;proverbCard&quot;&gt;&lt;img src=&quot;_data/resources/1_1795280006_shear.jpg&quot; alt=&quot;&quot;&gt;&lt;div class=&quot;proverbText&quot;&gt;&lt;h3&gt;One shears sheep, the other shears pigs&lt;/h3&gt;&lt;p&gt;One has all the advantages, the other has none. Sheep give wool; pigs give only noise.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;"
            }
