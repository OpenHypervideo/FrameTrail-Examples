            "frametrail:name": "To be a pillar-biter",
            "frametrail:thumb": "1_1795280001_thumb_pillar.jpg",
            "frametrail:licenseType": "PD",
            "frametrail:licenseAttribution": "Pieter Bruegel the Elder, Netherlandish Proverbs (1559). Gemäldegalerie, Berlin. Scan: Google Art Project, via Wikimedia Commons",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;proverbCard&quot;&gt;&lt;img src=&quot;_data/resources/1_1795280001_pillar.jpg&quot; alt=&quot;&quot;&gt;&lt;div class=&quot;proverbText&quot;&gt;&lt;h3&gt;To be a pillar-biter&lt;/h3&gt;&lt;p&gt;To be a religious hypocrite: so showily devout that he chews on the church pillars.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;"
            }
        }
