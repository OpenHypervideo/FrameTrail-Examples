            "frametrail:licenseAttribution": "Pieter Bruegel the Elder, Netherlandish Proverbs (1559). Gemäldegalerie, Berlin. Scan: Google Art Project, via Wikimedia Commons",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;proverbCard&quot;&gt;&lt;img src=&quot;_data/resources/1_1795280002_devil.jpg&quot; alt=&quot;&quot;&gt;&lt;div class=&quot;proverbText&quot;&gt;&lt;h3&gt;To tie even the devil to a pillow&lt;/h3&gt;&lt;p&gt;Obstinacy overcomes everything. Nothing can stop a truly stubborn person.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;"
            }
