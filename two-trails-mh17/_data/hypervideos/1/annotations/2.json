        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Witnesses near the launch",
            "frametrail:attributes": {
                "title": "Witnesses near the launch",
                "text": "&lt;p&gt;Some were very close: a very loud noise, a violent explosion, a high whistling sound. Others saw a plume of smoke, or a trail they describe as white, very thick and very long.&lt;/p&gt;"
            }
        }
    },
