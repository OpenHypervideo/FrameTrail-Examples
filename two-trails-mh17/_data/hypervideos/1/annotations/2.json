            "format": "text/html",
            "value": "",
            "frametrail:name": "The way back",
            "frametrail:attributes": {
                "title": "The way back",
                "text": "&lt;p&gt;Partly established from telecommunication data and the statement of a separatist who took part in the removal.&lt;/p&gt;"
            }
        }
    },
