            "value": "",
            "frametrail:name": "Satellite images of 16 and 21 July",
            "frametrail:attributes": {
                "title": "Satellite images of 16 and 21 July",
                "text": "&lt;p&gt;The later image shows a charred and ploughed patch that is not there on the earlier one, and the tracks of caterpillar vehicles.&lt;/p&gt;"
            }
        }
    },
