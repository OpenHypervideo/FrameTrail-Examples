            "value": "",
            "frametrail:name": "The original footage",
            "frametrail:attributes": {
                "title": "The original footage",
                "text": "&lt;p&gt;The photograph that Paris Match published was a still from a video. The team has since obtained the original footage.&lt;/p&gt;"
            }
        }
    },
