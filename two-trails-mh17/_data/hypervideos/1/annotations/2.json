            "value": "",
            "frametrail:name": "New images from Torez",
            "frametrail:attributes": {
                "title": "New images from Torez",
                "text": "&lt;p&gt;Shown with the background cut out, to protect the person who filmed them.&lt;/p&gt;"
            }
        }
    },
