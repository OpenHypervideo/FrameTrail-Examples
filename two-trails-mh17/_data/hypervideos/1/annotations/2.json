            "frametrail:name": "Lines of sight",
            "frametrail:attributes": {
                "title": "Lines of sight",
                "text": "&lt;p&gt;The directions in which the photographer and the witnesses were looking are drawn on the map. They meet very close to the farmland.&lt;/p&gt;"
            }
        }
    },
