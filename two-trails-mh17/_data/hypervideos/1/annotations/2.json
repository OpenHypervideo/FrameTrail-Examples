            "value": "",
            "frametrail:name": "Phone towers and intercepted calls",
            "frametrail:attributes": {
                "title": "Phone towers and intercepted calls",
                "text": "&lt;p&gt;Which telephone towers picked up the phones of the officers escorting the convoy, and recorded calls in which they talk about where they are and the route to follow.&lt;/p&gt;"
            }
        }
    },
