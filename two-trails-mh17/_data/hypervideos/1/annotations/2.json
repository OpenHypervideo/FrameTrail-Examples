            "frametrail:name": "The launch site",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;2&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;The investigators&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;The launch site&lt;/p&gt;&lt;p&gt;Farmland near Pervomaiskyi. The team says the evidence shows this “without any doubt”.&lt;/p&gt;&lt;p class=&quot;dossierLink&quot;&gt;&lt;a href=&quot;https://www.prosecutionservice.nl/topics/mh17-plane-crash/criminal-investigation-jit-mh17/jit-presentation-first-results-mh17-criminal-investigation-28-9-2016&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;The team&amp;#x27;s presentation of 28 September 2016 ↗&lt;/a&gt;&lt;/p&gt;&lt;/div&gt;"
