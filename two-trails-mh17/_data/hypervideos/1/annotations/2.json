        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Witnesses",
            "frametrail:attributes": {
                "title": "Witnesses",
                "text": "&lt;p&gt;Many people saw the launcher pass. After the public call of 2015, many said they were willing to testify.&lt;/p&gt;"
            }
        }
    },
