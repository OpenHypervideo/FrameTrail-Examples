            "frametrail:name": "The photograph, examined",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;2&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;The investigators&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;The photograph, examined&lt;/p&gt;&lt;p&gt;The Netherlands Forensic Institute found no indication that the photograph of the trail was manipulated. The Dutch meteorological institute notes it was neither a cloud nor an aircraft&amp;#x27;s contrail.&lt;/p&gt;&lt;/div&gt;"
            }
