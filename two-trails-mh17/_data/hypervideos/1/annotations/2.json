        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "A call at 9:22 am",
            "frametrail:attributes": {
                "title": "A call at 9:22 am",
                "text": "&lt;p&gt;The film plays an intercepted call of that morning. “It crossed, crossed the line”: the launcher came over the border under its own power and is now on a low-loader. It is to go “together with the Vostok tanks”.&lt;/p&gt;"
            }
        }
    },
