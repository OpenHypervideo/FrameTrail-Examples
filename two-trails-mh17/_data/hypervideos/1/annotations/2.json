            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Three missiles",
            "frametrail:attributes": {
                "title": "Three missiles",
                "text": "&lt;p&gt;In the video made in Luhansk in the early morning, only three missiles are on the launcher.&lt;/p&gt;"
            }
        }
    },
