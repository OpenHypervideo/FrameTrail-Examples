        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Two calls, 18 July, 7:41 and 7:44 am",
            "frametrail:attributes": {
                "title": "Two calls, 18 July, 7:41 and 7:44 am",
                "text": "&lt;p&gt;The escort brought the launcher to a crossroads and left it there; the man who took it over switched off his telephone when Strelkov and others began to call. “Where is the vehicle now?” “The vehicle is in Russia.”&lt;/p&gt;"
            }
        }
    },
