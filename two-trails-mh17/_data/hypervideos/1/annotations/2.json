        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Back across the border",
            "frametrail:attributes": {
                "title": "Back across the border",
                "text": "&lt;p&gt;Calls intercepted on the morning of 18 July show that the launcher was by then back in the Russian Federation.&lt;/p&gt;"
            }
        }
    }
