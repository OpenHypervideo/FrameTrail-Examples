            "value": "",
            "frametrail:name": "A call at 1:09 pm",
            "frametrail:attributes": {
                "title": "A call at 1:09 pm",
                "text": "&lt;p&gt;Two men who call each other Oleg and Lionia: “the last checkpoint leaving Snizhne before Stepanivka ... to the left ... Is my sense of direction correct?” “Go to Snizhne. I&amp;#x27;ll give you further directions there.”&lt;/p&gt;"
            }
        }
    },
