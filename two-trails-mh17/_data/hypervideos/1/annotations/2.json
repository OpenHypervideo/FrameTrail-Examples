        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "The photograph, examined",
            "frametrail:attributes": {
                "title": "The photograph, examined",
                "text": "&lt;p&gt;The Netherlands Forensic Institute found no indication that the photograph of the trail was manipulated. The Dutch meteorological institute notes it was neither a cloud nor an aircraft&amp;#x27;s contrail.&lt;/p&gt;"
            }
        }
    },
