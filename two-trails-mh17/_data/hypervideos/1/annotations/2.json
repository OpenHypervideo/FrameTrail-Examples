            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "A phone and a tower",
            "frametrail:attributes": {
                "title": "A phone and a tower",
                "text": "&lt;p&gt;The phone of one speaker in the intercepted call connects to the tower nearest the launch site, and the field and forest he describes match the surroundings.&lt;/p&gt;"
            }
        }
    },
