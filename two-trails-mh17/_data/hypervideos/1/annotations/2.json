        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "The convoy",
            "frametrail:attributes": {
                "title": "The convoy",
                "text": "&lt;p&gt;A white Volvo truck with a red low-loader, carrying the launcher with four missiles under a camouflage net; escorted by a Volkswagen Transporter and a UAZ jeep with armed men in uniform.&lt;/p&gt;"
            }
        }
    },
