            "format": "text/html",
            "value": "",
            "frametrail:name": "Witnesses near the launch",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;2&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;The investigators&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;Witnesses near the launch&lt;/p&gt;&lt;p&gt;Some were very close: a very loud noise, a violent explosion, a high whistling sound. Others saw a plume of smoke, or a trail they describe as white, very thick and very long.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
