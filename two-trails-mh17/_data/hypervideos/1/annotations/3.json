        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "The Luhansk video",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Open sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;The Luhansk video&lt;/p&gt;&lt;p&gt;Published on 18 July by Ukraine&amp;#x27;s interior ministry. The location was confirmed by geolocation and by journalists on the spot; truck and low-loader are the same as the day before.&lt;/p&gt;&lt;/div&gt;"
            }
        }
