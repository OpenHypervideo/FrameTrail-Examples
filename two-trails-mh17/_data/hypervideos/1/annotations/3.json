            "value": "",
            "frametrail:name": "Before and after",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Open sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;Before and after&lt;/p&gt;&lt;p&gt;Satellite imagery by DigitalGlobe shows that the burnt and ploughed area was absent on 16 July.&lt;/p&gt;&lt;/div&gt;"
            }
        }
