            "value": "",
            "frametrail:name": "Dating the Paris Match picture",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Open sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;Dating the Paris Match picture&lt;/p&gt;&lt;p&gt;Paris Match gave the time as about 11 am. An analysis of the shadows by the Ukraine@War blog put it at about 10 to 10:15 am.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
