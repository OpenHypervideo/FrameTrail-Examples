            "value": "",
            "frametrail:name": "The Zuhres video",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Open sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;The Zuhres video&lt;/p&gt;&lt;p&gt;Posted with the time and the coordinates. The coordinates were confirmed, and teams from ARD, Correctiv and 60 Minutes Australia later visited the spot.&lt;/p&gt;&lt;/div&gt;"
            }
