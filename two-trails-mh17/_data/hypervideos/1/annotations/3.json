            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "The smoke trail on Twitter",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Open sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;The smoke trail on Twitter&lt;/p&gt;&lt;p&gt;Shared a few hours after the crash. RTL Nieuws interviewed the photographer; Fox-IT and NIDF verified the pictures; NEO, TU Delft, Bellingcat and others geolocated them and the direction of the smoke.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
