            "value": "",
            "frametrail:name": "The last sighting",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Open sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;The last sighting&lt;/p&gt;&lt;p&gt;The Snizhne video is the last publicly known sighting on 17 July: the launcher heads south out of the town, towards farmland.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
