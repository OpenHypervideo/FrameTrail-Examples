            "frametrail:name": "Donetsk, after 9:40",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Open sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;Donetsk, after 9:40&lt;/p&gt;&lt;p&gt;Locals in Donetsk reported the launcher on social media, close to a separatist base known as the “Motel”.&lt;/p&gt;&lt;/div&gt;"
            }
        }
