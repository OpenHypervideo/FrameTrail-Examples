            "value": "",
            "frametrail:name": "The Torez photograph",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Open sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;The Torez photograph&lt;/p&gt;&lt;p&gt;Geolocated in Torez; the shadows put it at about 12:30. Reporters from the Guardian and BuzzFeed confirmed the time with residents a few days later.&lt;/p&gt;&lt;/div&gt;"
            }
        }
