            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Reporters in the field",
            "frametrail:attributes": {
                "text": "&lt;div class=&quot;dossierNote&quot; data-layer=&quot;3&quot;&gt;&lt;p class=&quot;dossierLayer&quot;&gt;Open sources&lt;/p&gt;&lt;p class=&quot;dossierTitle&quot;&gt;Reporters in the field&lt;/p&gt;&lt;p&gt;Roland Oliphant of the Daily Telegraph and Christopher Miller of Mashable found a field with a burnt corner. Their photographs were used to geolocate it.&lt;/p&gt;&lt;/div&gt;"
            }
        }
    },
