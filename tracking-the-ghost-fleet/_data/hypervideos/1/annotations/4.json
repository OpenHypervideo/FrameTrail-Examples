            "frametrail:name": "New routes to Iran",
            "frametrail:attributes": {
                "title": "New routes to Iran",
                "text": "&lt;p&gt;Two ships sailed directly to Iran. The film says these routes had not been reported before.&lt;/p&gt;"
            }
