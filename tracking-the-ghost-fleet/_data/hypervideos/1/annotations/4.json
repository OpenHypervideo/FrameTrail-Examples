        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Three ways out",
            "frametrail:attributes": {
                "title": "Three ways out",
                "text": "&lt;p&gt;Directly from Sevastopol to ports in countries such as Syria or Iran; or with one ship-to-ship transfer; or with several. The transfers happen in the Kerch Strait and mask where the grain came from.&lt;/p&gt;"
            }
        }
    },
