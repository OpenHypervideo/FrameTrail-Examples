            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "A system, not an incident",
            "frametrail:attributes": {
                "title": "A system, not an incident",
                "text": "&lt;p&gt;The film calls it a systematic, years-long effort by Russia to profit from grain harvested in occupied Ukraine.&lt;/p&gt;"
            }
        }
    },
