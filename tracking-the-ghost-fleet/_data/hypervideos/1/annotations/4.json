            "format": "text/html",
            "value": "",
            "frametrail:name": "The same ships under a new name",
            "frametrail:attributes": {
                "title": "The same ships under a new name",
                "text": "&lt;p&gt;At least three tracked shipments were transferred to ships that used to belong to one company and now operate under another company&amp;#x27;s name.&lt;/p&gt;"
            }
