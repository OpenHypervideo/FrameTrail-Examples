        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Craters between the rows",
            "frametrail:attributes": {
                "title": "Craters between the rows",
                "text": "&lt;p&gt;Bilopillia has been shelled, and so have the fields. “We are doing everything we can to harvest on time and provide grain to Ukraine and all other countries that need it.”&lt;/p&gt;"
            }
        }
    },
    {
        "@context": [
            "http://www.w3.org/ns/anno.jsonld",
