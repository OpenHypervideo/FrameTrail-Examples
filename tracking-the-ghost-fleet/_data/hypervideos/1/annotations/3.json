        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "“Where should I go?”",
            "frametrail:attributes": {
                "title": "“Where should I go?”",
                "text": "&lt;p&gt;“I have 700 pigs. Should I let them run around the fields and explode on mines? We will work.”&lt;/p&gt;"
            }
        }
    },
    {
        "@context": [
            "http://www.w3.org/ns/anno.jsonld",
