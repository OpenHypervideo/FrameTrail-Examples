        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Said in public",
            "frametrail:attributes": {
                "title": "Said in public",
                "text": "&lt;p&gt;The acting governor of occupied Zaporizhzhia, the head of occupied Crimea and Russia&amp;#x27;s president have all announced plans to export grain through occupied ports.&lt;/p&gt;"
            }
        }
    },
