        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Fifteen years on these fields",
            "frametrail:attributes": {
                "title": "Fifteen years on these fields",
                "text": "&lt;p&gt;Wheat, barley, corn, buckwheat, soybeans and sunflower. “In Ukraine they say that bread is the head of everything.”&lt;/p&gt;"
            }
        }
    },
    {
        "@context": [
            "http://www.w3.org/ns/anno.jsonld",
            "https://frametrail.org/ns/context.jsonld"
        ],
        "creator": {
