        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Associated Press and PBS",
            "frametrail:attributes": {
                "title": "Associated Press and PBS",
                "text": "&lt;p&gt;Farmers in occupied regions told an earlier investigation the same: they have little choice but to sell at the price the Russian authorities set.&lt;/p&gt;"
            }
        }
    },
