        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Bellingcat: Grain Trail",
            "frametrail:attributes": {
                "title": "Bellingcat: Grain Trail",
                "text": "&lt;p&gt;In the first year of the invasion Bellingcat counted at least 179 days on which ships lay at the sanctioned Avlita terminal with their transponders apparently off: 148 found in Planet&amp;#x27;s satellite images, 31 more with a ship-detection tool using radar from the Sentinel-1 satellite.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://www.bellingcat.com/news/2023/05/11/grain-trail-tracking-russias-ghost-ships-with-satellite-imagery/&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Bellingcat: Grain Trail ↗&lt;/a&gt;&lt;/p&gt;"
            }
        }
    },
