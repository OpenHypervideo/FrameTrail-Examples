        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "No one comes for the grain",
            "frametrail:attributes": {
                "title": "No one comes for the grain",
                "text": "&lt;p&gt;Drivers do not want to come because of the shelling; only those who really need grain take it. “Every day it is getting harder and harder.”&lt;/p&gt;"
            }
        }
    },
