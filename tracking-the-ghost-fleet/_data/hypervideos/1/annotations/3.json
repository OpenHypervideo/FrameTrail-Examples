            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Petro Melnyk",
            "frametrail:attributes": {
                "title": "Petro Melnyk",
                "text": "&lt;p&gt;Chief executive and co-founder of Agricom Group, with farms across Ukraine, and in contact with farmers in the occupied regions: “It&amp;#x27;s like mafia rule.”&lt;/p&gt;"
            }
        }
    },
