                "value": "t=217,242"
            }
        },
        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Sixty per cent less",
            "frametrail:attributes": {
                "title": "Sixty per cent less",
                "text": "&lt;p&gt;What he earns for wheat has fallen by 60 per cent. The field is 6.5 to 7 kilometres from the Russian border, under constant mortar and artillery fire.&lt;/p&gt;"
            }
        }
    },
    {
        "@context": [
            "http://www.w3.org/ns/anno.jsonld",
