            "frametrail:name": "David Crane",
            "frametrail:attributes": {
                "title": "David Crane",
                "text": "&lt;p&gt;A former international prosecutor. On switching off the transponder: “good circumstantial evidence that they know what they&amp;#x27;re doing is wrong”.&lt;/p&gt;"
