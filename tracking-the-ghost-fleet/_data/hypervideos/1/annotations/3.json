        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Amanda Countryman",
            "frametrail:attributes": {
                "title": "Amanda Countryman",
                "text": "&lt;p&gt;An agricultural economist at Colorado State University: about 30 per cent of Ukraine is occupied. The theft of grain is the immediate concern; what occupation does to farming is the longer one.&lt;/p&gt;"
            }
        }
    },
    {
        "@context": [
