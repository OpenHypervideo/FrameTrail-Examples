        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "The United Nations",
            "frametrail:attributes": {
                "title": "The United Nations",
                "text": "&lt;p&gt;The Secretary-General regrets Russia&amp;#x27;s decision to end the Black Sea Grain Initiative, the deal that had let Ukraine ship grain past the blockade.&lt;/p&gt;"
            }
        }
    },
