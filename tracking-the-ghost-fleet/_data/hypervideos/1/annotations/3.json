            "format": "text/html",
            "value": "",
            "frametrail:name": "The partners",
            "frametrail:attributes": {
                "title": "The partners",
                "text": "&lt;p&gt;Scripps News with Bellingcat and Lloyd&amp;#x27;s List Intelligence, a firm that tracks ships worldwide.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://www.scrippsnews.com/world/russia-s-ghost-fleet&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;The story at Scripps News ↗&lt;/a&gt;&lt;/p&gt;"
            }
        }
    },
