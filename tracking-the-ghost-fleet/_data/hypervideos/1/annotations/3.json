            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Valery Lyuty",
            "frametrail:attributes": {
                "title": "Valery Lyuty",
                "text": "&lt;p&gt;A grain farmer near Bilopillia in the north-east, in his field during the wheat harvest of 2023: “Wheat is the gold of Ukraine.”&lt;/p&gt;"
            }
        }
    },
    {
        "@context": [
            "http://www.w3.org/ns/anno.jsonld",
            "https://frametrail.org/ns/context.jsonld"
        ],
