            "format": "text/html",
            "value": "",
            "frametrail:name": "Going dark",
            "frametrail:attributes": {
                "title": "Going dark",
                "text": "&lt;p&gt;Ships broadcast their position through the automatic identification system, AIS. The Mikhail Nenashev switched it off in Sevastopol and on again in the Kerch Strait, so that it appeared to sail from a Russian port.&lt;/p&gt;"
            }
        }
    },
