            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "The choke point",
            "frametrail:attributes": {
                "title": "The choke point",
                "text": "&lt;p&gt;Every ship leaving the Black Sea passes through the Bosphorus in Istanbul. There it can be seen, photographed and identified, whatever its transponder says.&lt;/p&gt;"
            }
        }
    },
