        "body": {
            "type": "TextualBody",
            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Two kinds of data",
            "frametrail:attributes": {
                "title": "Two kinds of data",
                "text": "&lt;p&gt;Satellite imagery shows where a ship is. Shipping data shows where it says it is. The investigation works in the gap between the two.&lt;/p&gt;"
            }
        }
    },
