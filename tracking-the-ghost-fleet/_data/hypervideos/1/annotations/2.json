            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Ships as a network",
            "frametrail:attributes": {
                "title": "Ships as a network",
                "text": "&lt;p&gt;Each ship is a dot; two dots are linked if the ships ever transferred cargo to each other. With about 12,000 transfers in the area in a few years, no person could trace the paths by hand.&lt;/p&gt;"
            }
        }
    },
