            "format": "text/html",
            "value": "",
            "frametrail:name": "Knowing the regulars",
            "frametrail:attributes": {
                "title": "Knowing the regulars",
                "text": "&lt;p&gt;The ship-spotter&amp;#x27;s method: know the ships that work these routes, notice the one that does not fit, and notice a ship coming back full after a gap in its track on the Black Sea. Satellite images later confirm it.&lt;/p&gt;"
            }
        }
