            "format": "text/html",
            "value": "",
            "frametrail:name": "Reading the clusters",
            "frametrail:attributes": {
                "title": "Reading the clusters",
                "text": "&lt;p&gt;The ships known to have loaded in Sevastopol fall into two groups of the network. Follow whom they load onto, and four or five big ships remain, all with the same owner.&lt;/p&gt;"
            }
        }
    },
