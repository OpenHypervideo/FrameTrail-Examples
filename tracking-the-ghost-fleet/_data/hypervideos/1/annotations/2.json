            "frametrail:type": "text",
            "format": "text/html",
            "value": "",
            "frametrail:name": "Filling the gaps from orbit",
            "frametrail:attributes": {
                "title": "Filling the gaps from orbit",
                "text": "&lt;p&gt;AIS data from Lloyd&amp;#x27;s List Intelligence is combined with satellite imagery from Planet Labs. That pinpoints ship-to-ship transfers in the Kerch Strait even when a transponder is off.&lt;/p&gt;"
            }
        }
    },
