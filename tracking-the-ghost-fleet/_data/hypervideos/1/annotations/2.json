            "value": "",
            "frametrail:name": "One ship, three sightings",
            "frametrail:attributes": {
                "title": "One ship, three sightings",
                "text": "&lt;p&gt;A satellite image at a port in occupied Crimea, a video in the Bosphorus, a satellite image at a port in Iran: the case rests on recognising the same vessel in each.&lt;/p&gt;"
            }
        }
    },
